# AI RiskGuard — Environment Variables
# Copy to .env and fill in as needed. The app works without any of these set.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in ./data/airiskguard.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/airiskguard

# ── AI Provider (optional) ───────────────────────────────────────────────────
# AI_PROVIDER=local        (default) — no LLM, uses sentence extraction fallback
# AI_PROVIDER=ollama       — uses local Ollama instance for summarisation
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Research Settings ─────────────────────────────────────────────────────────
# Maximum sources to fetch per research run (keep low to avoid rate-limiting)
RESEARCH_MAX_SOURCES=5
# HTTP fetch timeout per source page (seconds)
RESEARCH_FETCH_TIMEOUT=10
# Maximum characters of page text to store per source
RESEARCH_CONTENT_LIMIT=8000
# Delay between search requests (seconds) to respect rate limits
RESEARCH_REQUEST_DELAY=1.5
